{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "NetVigil",
    "Audience": "NetVigil.Client",
    "ExpiryMinutes": 480
  },
  "Auth": {
    "DefaultAdmin": {
      "Username": "admin",
      "Password": "admin"
    }
  },
  "Anomaly": {
    "Detector": "isolation-forest",
    "ModelPath": "/app/data/anomaly-model.json"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "DataProtection": {
    "KeyPath": "/app/data/dpkeys"
  }
}
